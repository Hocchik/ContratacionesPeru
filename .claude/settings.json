{
  "permissions": {
    "allow": [
      "Bash(dbt debug)",
      "Bash(dbt parse)",
      "Bash(dbt compile *)",
      "Bash(dbt build *)",
      "Bash(dbt test *)",
      "Bash(dbt show *)",
      "Bash(dbt ls *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(psql *)",
      "Bash(pip install *)",
      "Bash(uv pip install *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/secrets/**)",
      "Read(~/.dbt/profiles.yml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  }
}
